# Stage 1: Install Node.js AI CLI tools (apt-free — uses node base image)
FROM node:22-slim AS node-cli
RUN npm install -g @anthropic-ai/claude-code@latest 2>/dev/null || true \
    && npm install -g @openai/codex@latest 2>/dev/null || true

# Stage 2: Python application
FROM python:3.14-slim-bookworm

WORKDIR /app

# Copy Node.js runtime + CLI tools from stage 1
COPY --from=node-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=node-cli /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/.bin/* /usr/local/bin/ 2>/dev/null || true \
    && ln -sf /usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js /usr/local/bin/claude 2>/dev/null || true \
    && ln -sf /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex 2>/dev/null || true

# Install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code
COPY backend/ .

# Create local-data directory structure and non-root user
RUN mkdir -p /app/local-data/youtube/channels \
             /app/local-data/dcinside \
             /app/local-data/vuddy/comprehensive_analysis \
             /app/local-data/analysis \
             /app/logs \
    && groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser

# Playwright Chromium for DCInside comment fallback (when API blocks server-side)
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN (apt-get update -qq \
    && playwright install-deps chromium \
    && playwright install chromium \
    && chown -R appuser:appuser /opt/pw-browsers \
    && rm -rf /var/lib/apt/lists/*) || true

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1

CMD ["python", "run.py"]
